{
  "name": "mcp-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mcp-server",
    "mcp-client"
  ],
  "scripts": {
    "start": "npm start --workspace=mcp-server",
    "dev": "concurrently \"npm run start:dev --workspace=mcp-server\" \"npm start --workspace=mcp-client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "lucide-react": "^0.548.0",
    "recharts": "^3.3.0",
    "zustand": "^5.0.8"
  }
}
